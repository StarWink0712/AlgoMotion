# Optional: presets and local title/link matching work without a key.
# You can instead configure DeepSeek, Kimi, OpenAI or custom APIs in the UI.
# UI profiles take precedence. Save defaults to disk and restores the active profile on restart.
# Named profiles and keys are plaintext in .algomotion/model-settings.json (git-ignored).
# Browser storage never contains keys. Temporary use does not delete saved profiles.
# Set ALGOMOTION_SETTINGS_MODE=memory to disable loading/saving this file.
# Set all three values to enable an OpenAI-compatible Chat Completions provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# json_schema (default), json_object, or prompt (no response_format parameter).
# Official DeepSeek/Moonshot hosts use max_tokens; others use max_completion_tokens.
# Advanced token/thinking compatibility and output budget can be changed in the UI.
LLM_RESPONSE_FORMAT=json_schema
# Generation setup: macOS uses Colima + Docker CLI (no Docker Desktop).
# Windows: run inside WSL2 with Docker Engine; Linux: use an existing Engine.
# macOS bootstrap: npm run setup -- --install-docker
# auto: prefer the managed Colima profile if present, otherwise reuse the current engine.
# colima: explicitly select/provision the macOS profile, even if another engine is running.
# external: never auto-start Colima; use your existing Docker connection.
ALGOMOTION_CONTAINER_RUNTIME=auto
# Trusted image must carry org.algomotion.runner=1; execution pins the inspected image ID.
ALGOMOTION_SANDBOX_IMAGE=algomotion-python:1
# Optional overrides. Homebrew CLI paths and existing Desktop CLI paths are discovered.
# Explicit DOCKER_BIN / DOCKER_HOST / DOCKER_CONTEXT take priority over auto discovery.
# Do not combine colima mode with DOCKER_HOST or DOCKER_CONTEXT.
# DOCKER_BIN=/absolute/path/to/docker
# DOCKER_CONTEXT=your-existing-context
# Switching runtime/context requires restarting the API and building the image there.
# Opt in ONLY when running npm run test:live (real API calls may incur charges).
ALGOMOTION_LIVE_ACCEPT=0
PORT=3001
HOST=127.0.0.1
# If PORT is changed, use the same port for Vite's API proxy.
ALGOMOTION_API_PORT=3001
